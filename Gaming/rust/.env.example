# Rust (VPS/local) example
#
# Copy to .env and edit. For Flux marketplace deployments, use flux-spec.json as a starting point.

# SteamCMD
AUTO_UPDATE=true
STEAMCMD_VALIDATE=false
STEAM_BRANCH=

# Server identity / listing
RUST_SERVER_IDENTITY=rust
RUST_SERVER_NAME=RunOnFlux - Rust (VPS)
RUST_SERVER_DESCRIPTION=Rust dedicated server on a VPS (Flux-friendly image).
RUST_SERVER_TAGS=vanilla,flux

# Networking
RUST_SERVER_PORT=28015
RUST_RCON_PORT=28016
RUST_SERVER_QUERYPORT=28017

# World settings
RUST_LEVEL=Procedural Map
# If set to 0, the container will generate a random seed once and persist it to /config
RUST_SEED=0
RUST_WORLD_SIZE=3000
RUST_MAX_PLAYERS=50
RUST_SAVE_INTERVAL=600

# RCON (set this!)
RUST_RCON_PASSWORD=test1234
RUST_RCON_WEB=true

# Flux failover safety (useful on VPS too if you simulate failover/startups)
RUST_SYNC_WAIT_SECONDS=900
RUST_SYNC_WAIT_FAIL=true
