{
  "version": 8,
  "name": "rust-flux",
  "description": "Rust Dedicated Server (official via SteamCMD). Uses local /data for install/cache and synced g:/config for saves/config. Ports: 28015/udp (game), 28016/tcp (rcon), 28017/udp (query).",
  "owner": "YOUR_ZELID_HERE",
  "compose": [
    {
      "name": "data",
      "description": "Local cache volume for Steam (not synced)",
      "repotag": "alpine:3.20",
      "ports": [],
      "domains": [],
      "environmentParameters": [],
      "commands": [
        "sh",
        "-lc",
        "while true; do sleep 3600; done"
      ],
      "containerPorts": [],
      "containerData": "/data",
      "cpu": 0.1,
      "ram": 200,
      "hdd": 30,
      "repoauth": ""
    },
    {
      "name": "server",
      "description": "Rust server (g:/config for saves/config; local /data install)",
      "repotag": "runonflux/rust-flux:latest",
      "ports": [
        28015,
        28016,
        28017
      ],
      "containerPorts": [
        28015,
        28016,
        28017
      ],
      "domains": [
        "",
        "",
        ""
      ],
      "environmentParameters": [
        "RUST_SERVER_IDENTITY=rust",
        "RUST_SERVER_NAME=RunOnFlux - Rust",
        "RUST_SERVER_DESCRIPTION=Rust dedicated server on Flux.",
        "RUST_SERVER_TAGS=vanilla,flux",
        "RUST_SERVER_PORT=28015",
        "RUST_RCON_PORT=28016",
        "RUST_SERVER_QUERYPORT=28017",
        "RUST_RCON_PASSWORD=CHANGE_ME",
        "RUST_RCON_WEB=true",
        "RUST_LEVEL=Procedural Map",
        "RUST_SEED=0",
        "RUST_WORLD_SIZE=3000",
        "RUST_MAX_PLAYERS=100",
        "RUST_SAVE_INTERVAL=600",
        "AUTO_UPDATE=true",
        "STEAMCMD_VALIDATE=false"
      ],
      "commands": [],
      "containerData": "g:/config|0:/data",
      "cpu": 4,
      "ram": 8000,
      "hdd": 20,
      "repoauth": ""
    }
  ],
  "instances": 3,
  "contacts": [],
  "geolocation": [],
  "expire": 22000,
  "nodes": [],
  "staticip": false,
  "enterprise": ""
}
