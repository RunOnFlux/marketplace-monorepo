# Project Zomboid (VPS/local) example
#
# Copy to .env and edit. For Flux marketplace deployments, use flux-spec.json as a starting point.

# SteamCMD
AUTO_UPDATE=true
STEAMCMD_VALIDATE=false
STEAM_BRANCH=

# Server identity
PZ_SERVER_NAME=servertest
PZ_PUBLIC_NAME=RunOnFlux - Project Zomboid (VPS)
PZ_PUBLIC_DESCRIPTION=Project Zomboid dedicated server on a VPS (Flux-friendly image).

# Gameplay / listing
PZ_PUBLIC=true
PZ_OPEN=true
PZ_MAX_PLAYERS=16
PZ_PVP=false
PZ_MAP=Muldraugh, KY
PZ_SAVE_EVERY_MINUTES=10

# Passwords (for testing)
PZ_PASSWORD=test1234
PZ_ADMIN_USERNAME=admin
PZ_ADMIN_PASSWORD=test1234

# Mods (semicolon or comma separated)
PZ_MODS=
PZ_WORKSHOP_ITEMS=

# JVM memory (keep <= container RAM)
PZ_JAVA_XMS=512m
PZ_JAVA_XMX=2048m

