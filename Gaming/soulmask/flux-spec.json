{
  "version": 8,
  "name": "soulmask-flux",
  "description": "Soulmask Dedicated Server (official Linux via SteamCMD). Uses local /data for install/cache and synced g:/config for saves. Ports: 7777/udp (game) and 27015/udp (query).",
  "owner": "YOUR_ZELID_HERE",
  "compose": [
    {
      "name": "data",
      "description": "Local cache volume for Steam (not synced)",
      "repotag": "alpine:3.20",
      "ports": [],
      "domains": [],
      "environmentParameters": [],
      "commands": [
        "sh",
        "-lc",
        "while true; do sleep 3600; done"
      ],
      "containerPorts": [],
      "containerData": "/data",
      "cpu": 0.1,
      "ram": 200,
      "hdd": 25,
      "repoauth": ""
    },
    {
      "name": "server",
      "description": "Soulmask server (g:/config for saves; local /data install)",
      "repotag": "runonflux/soulmask-flux:latest",
      "ports": [
        7777,
        27015,
        19000
      ],
      "containerPorts": [
        7777,
        27015,
        19000
      ],
      "domains": [
        "",
        "",
        ""
      ],
      "environmentParameters": [
        "SOULMASK_SERVER_NAME=RunOnFlux - Soulmask",
        "SOULMASK_MAP=Level01_Main",
        "SOULMASK_GAME_MODE=pve",
        "SOULMASK_PASSWORD=CHANGE_ME",
        "SOULMASK_ADMIN_PASSWORD=CHANGE_ME",
        "SOULMASK_MAX_PLAYERS=20",
        "SOULMASK_PORT=7777",
        "SOULMASK_QUERY_PORT=27015",
        "SOULMASK_SAVING_INTERVAL=600",
        "SOULMASK_BACKUP_INTERVAL=900",
        "SOULMASK_INIT_BACKUP=true",
        "SOULMASK_BACKUP_INTERVAL_MINUTES=10",
        "SOULMASK_GAMEDISTINDEX=1",
        "SOULMASK_MOD_ID=",
        "SOULMASK_EXTRA_ARGS="
      ],
      "commands": [],
      "containerData": "g:/config|0:/data",
      "cpu": 4,
      "ram": 16000,
      "hdd": 10,
      "repoauth": ""
    }
  ],
  "instances": 3,
  "contacts": [],
  "geolocation": [],
  "expire": 22000,
  "nodes": [],
  "staticip": false,
  "enterprise": ""
}
